{
  "name": "mockwave",
  "version": "0.0.1",
  "description": "Mockwave - The data-mocking Wave. Copy-as-code pattern for generating realistic mock data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p engine --noEmit && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:sql": "UPDATE_SQL=1 vitest run engine/src/store/sql.test.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.18.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.3.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
